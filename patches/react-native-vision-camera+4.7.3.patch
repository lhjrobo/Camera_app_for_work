+package com.mrousavy.camera.core
+
+import android.util.Log
+
+/**
+ * Holder for Camera2 API settings that can be applied via Camera2Interop.
+ * These settings are accessed from the app's native module and applied during camera configuration.
+ */
+object Camera2SettingsHolder {
+    private const val TAG = "Camera2SettingsHolder"
+    
+    /**
+     * Edge mode setting for CaptureRequest.EDGE_MODE
+     * -1 means use default (don't set)
+     */
+    @Volatile
+    var edgeMode: Int = -1
+        set(value) {
+            Log.d(TAG, "Edge mode set to: $value")
+            field = value
+        }
+    
+    /**
+     * Noise reduction mode setting for CaptureRequest.NOISE_REDUCTION_MODE
+     * -1 means use default (don't set)
+     */
+    @Volatile
+    var noiseReductionMode: Int = -1
+        set(value) {
+            Log.d(TAG, "Noise reduction mode set to: $value")
+            field = value
+        }
+    
+    /**
+     * Reset settings to defaults
+     */
+    fun reset() {
+        edgeMode = -1
+        noiseReductionMode = -1
+    }
+}
